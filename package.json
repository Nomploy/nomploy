{
	"name": "nomploy",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"nomploy:setup": "pnpm --filter=nomploy run setup",
		"nomploy:dev": "pnpm --filter=nomploy run dev",
		"nomploy:build": "pnpm --filter=nomploy run build",
		"nomploy:start": "pnpm --filter=nomploy run start",
		"test": "pnpm --filter=nomploy run test",
		"server:script": "pnpm --filter=server run switch:dev",
		"server:dev": "pnpm --filter=server run dev",
		"server:build": "pnpm --filter=server run build",
		"docker:build:canary": "./apps/dokploy/docker/build.sh canary",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "pnpm --filter=nomploy run generate:openapi",
		"release": "bash scripts/release.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.1",
		"@types/node": "^24.4.0",
		"dotenv": "16.4.5",
		"esbuild": "0.25.12",
		"lint-staged": "^15.5.2",
		"tsx": "4.16.2"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.4.0",
		"pnpm": ">=9.12.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"overrides": {
			"esbuild": "0.25.12",
			"@ai-sdk/provider-utils@4": "^4.0.33",
			"@babel/core@7": "^7.29.6",
			"@grpc/grpc-js@1": "^1.14.4",
			"@hono/node-server@1": "^1.19.15",
			"@protobufjs/utf8@1": "^1.1.1",
			"@rvf/set-get@7": "^7.0.2",
			"@xmldom/xmldom@0.8": "^0.8.15",
			"axios@1": "^1.18.0",
			"baseline-browser-mapping@2": "^2.11.0",
			"brace-expansion@1": "^1.1.21",
			"brace-expansion@2": "^2.1.7",
			"brace-expansion@5": "^5.0.12",
			"browserslist@4": "^4.28.7",
			"defu@6": "^6.1.5",
			"dompurify@3": "^3.4.16",
			"effect@3": "^3.20.0",
			"fast-xml-builder@1": "^1.1.7",
			"fast-xml-parser@5": "^5.7.0",
			"follow-redirects@1": "^1.16.0",
			"form-data@4": "^4.0.6",
			"h3@1": "^1.15.9",
			"hono@4": "^4.13.5",
			"immutable@3": "^3.8.4",
			"ip-address@10": "^10.7.1",
			"js-cookie@3": "^3.0.7",
			"js-yaml@4": "^4.3.2",
			"kysely@0.28": "^0.28.17",
			"lodash@4": "^4.18.0",
			"minimatch@3": "^3.1.4",
			"minimatch@9": "^9.0.7",
			"minimatch@10": "^10.2.3",
			"mysql2@3": "^3.23.1",
			"nanoid@3": "^3.3.18",
			"node-forge@1": "^1.4.0",
			"picomatch@2": "^2.3.2",
			"picomatch@4": "^4.0.4",
			"postcss-selector-parser@6": "^6.1.3",
			"postcss@8": "^8.5.23",
			"prismjs@1": "^1.30.0",
			"protobufjs@7": "^7.6.5",
			"qs@6": "^6.16.0",
			"samlify@2": "^2.13.0",
			"shell-quote@1": "^1.9.0",
			"tar-fs@2": "^2.1.4",
			"undici@6": "^6.28.1",
			"valibot@1": "^1.4.2",
			"vitest@4": "^4.1.11",
			"@vitest/mocker@4": "^4.1.11",
			"ws@8": "^8.22.0",
			"yaml@2": "^2.8.3",
			"vite": "^7.3.5"
		},
		"peerDependencyRules": {
			"ignoreMissing": [
				"prisma",
				"@prisma/client",
				"@prisma/engines",
				"@electric-sql/pglite",
				"typescript",
				"drizzle-kit"
			]
		},
		"onlyBuiltDependencies": [
			"@scarf/scarf",
			"@tree-sitter-grammars/tree-sitter-yaml",
			"bcrypt",
			"better-sqlite3",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"msgpackr-extract",
			"node-pty",
			"protobufjs",
			"sharp",
			"ssh2",
			"tree-sitter",
			"tree-sitter-json"
		]
	}
}
